# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/citizen_diary

# Redis
REDIS_URL=redis://localhost:6379

# LLM (Google Gemini — primário)
LLM_PROVIDER=gemini
LLM_API_KEY=sua_chave_gemini_aqui
LLM_MODEL=gemini-2.0-flash

# LLM (Cerebras — fallback quando Gemini esgota quota)
CEREBRAS_API_KEY=sua_chave_cerebras_aqui
CEREBRAS_MODEL=gpt-oss-120b

# Game
DEFAULT_PLAYER_ID=player-001
TICK_INTERVAL_MS=1800000

# Server
PORT=3000
NODE_ENV=production

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/citizen_diary

# Redis
REDIS_URL=redis://redis:6379

# LLM
LLM_PROVIDER=cerebras
CEREBRAS_API_KEY=your_cerebras_key_here
CEREBRAS_MODEL=gpt-oss-120b

# Game
DEFAULT_PLAYER_ID=player-001
TICK_INTERVAL_MS=1800000

# Cooldowns
PRAY_COOLDOWN_MS=3600000
LLM_RETRY_COOLDOWN_MS=3600000
CEREBRAS_RETRY_COOLDOWN_MS=3600000


